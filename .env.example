# LLM Configuration
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.0

# API Keys (set the one corresponding to LLM_PROVIDER)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Dataset Configuration
DATASET_PATH=dataset/sales.csv
# DATASET_PATH=s3://juliosilvacwb-private/sales.csv
LOG_LEVEL=INFO

# S3 Remote Dataset Configuration (Zero-Copy Querying)
# When DATASET_PATH starts with s3://, DuckDB streams data directly from S3
# via httpfs extension without loading the full dataset into memory.
# Least-Privilege IAM Policy: Actions: s3:GetObject, s3:ListBucket on target ARN.
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=your_session_token_here
# AWS_ENDPOINT_URL=http://localhost:9000
# S3_USE_SSL=true

# Session Storage Configuration (Stateless Architecture)
# Options: 'memory' (default, local dev) or 'redis' (production / K3s)
SESSION_STORE=memory
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# Authentication Configuration (Zero Trust Microservice)
# Set to true to enforce JWT validation on protected endpoints (POST /chat)
AUTH_ENABLED=false
# URL of the Authentication Microservice
AUTH_SERVICE_URL=http://localhost:8001
# Authorized admin credentials for Auth Service login
AUTH_USER=admin
AUTH_PASSWORD=changeme
# JWT token validity in minutes
JWT_EXPIRATION_MINUTES=60
# RSA Key Pair file paths (generated automatically if not present)
RSA_PRIVATE_KEY_PATH=keys/private_key.pem
RSA_PUBLIC_KEY_PATH=keys/public_key.pem
# Optional PEM inline keys (for K8s Secrets injection)
# RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."
# RSA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n..."
